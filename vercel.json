{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/crawl/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/alerts/sweep",
      "schedule": "*/2 * * * *"
    }
  ],
  "functions": {
    "app/api/crawl/cron/route.ts": {
      "maxDuration": 60
    },
    "app/api/crawl/submit/route.ts": {
      "maxDuration": 30
    },
    "app/api/alerts/sweep/route.ts": {
      "maxDuration": 60
    }
  }
}
