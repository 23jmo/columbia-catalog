{
  "manifest_version": 3,
  "name": "LionPlan — Vergil Schedule Capture",
  "description": "Refresh LionPlan with sanitized course times and locations already loaded by Vergil.",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Vergil schedule capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://vergil.columbia.edu/vergil/*"],
      "js": ["sanitizer.js", "observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://vergil.columbia.edu/vergil/*"],
      "js": ["capture-schema.js", "scan-helpers.js", "bridge.js", "scanner.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "externally_connectable": {
    "matches": ["https://columbia-catalog.vercel.app/*"]
  },
  "homepage_url": "https://columbia-catalog.vercel.app"
}
